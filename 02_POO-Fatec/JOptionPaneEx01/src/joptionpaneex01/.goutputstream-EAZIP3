package joptionpaneex01;

import javax.swing.JOptionPane;
import java.text.DecimalFormat;
import java.util.Calendar;

public class JOptionPaneEx01 {
    // Metodo que Calcula e monta o relatorio (Retorna String montada)
    public static String processarReajuste(String nome, double salario) {
        DecimalFormat formato = new DecimalFormat("R$: #,##0.00");
        double reajustePorcentagem;

        if (salario <= 1200) {
            reajustePorcentagem = 10.0;
        } else {
            reajustePorcentagem = 5.0;
        }

        double valorReajuste = salario * (reajustePorcentagem / 100);
        double salarioNovo = salario + valorReajuste;

        // StringBuilder para contruir a saída de forma eficiente
        StringBuilder sb = new StringBuilder();
        sb.append("Nome: ").append(nome).append("\n");
        sb.append("Salario: ").append(formato.format(salario)).append("\n");
        sb.append("Percentual de Reajuste: ").append(reajustePorcentagem).append("\n");
        sb.append("Valor do Reajuste: ").append(formato.format(valorReajuste)).append("\n\n");
        sb.append("Salário Novo: ").append(formato.format(salarioNovo));

        return sb.toString();
    }
    // Metodo Main
    public static void main(String[] args) {

        // Caixas de Entrada de dados
        String nomeCompleto = JOptionPane.showInputDialog(null, "Digite o nome do funcionario", "Entrada", JOptionPane.QUESTION_MESSAGE);

        if (nomeCompleto != null) {
            String salarioStr = JOptionPane.showInputDialog(null, "Digite o Salario do Funcionario", JOptionPane.QUESTION_MESSAGE);

            if (salarioStr != null) {
                double salario =  Double.parseDouble(salarioStr);

                // Aplica o metodo
                String resultadoFinal = processarReajuste(nomeCompleto, salario);

                // Exibir o resultado limpo
                JOptionPane.showMessageDialog(null, resultadoFinal, "Resultado do Reajuste", JOptionPane.INFORMATION_MESSAGE);


            }
        }


    }


}



